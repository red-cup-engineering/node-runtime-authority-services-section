{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.561.group/identity-document-access/analysis.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "caseId", "caseRecordType", "jurisdiction", "goals", "nodes", "claims", "steps", "obligations", "research"],
  "properties": {
    "version": { "const": 1 },
    "caseId": { "type": "string", "minLength": 1 },
    "caseRecordType": { "type": "string", "minLength": 1 },
    "jurisdiction": { "type": "string", "minLength": 1 },
    "goals": { "type": "array", "items": { "$ref": "#/$defs/id" }, "minItems": 1, "uniqueItems": true },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" }, "minItems": 1 },
    "claims": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
    "steps": { "type": "array", "items": { "$ref": "#/$defs/step" } },
    "obligations": { "type": "array", "items": { "$ref": "#/$defs/obligation" } },
    "research": { "type": "array", "items": { "$ref": "#/$defs/research" } }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["side", "casePointer", "basis"],
      "properties": {
        "side": { "enum": ["for", "against"] },
        "casePointer": { "type": "string", "pattern": "^/" },
        "basis": { "enum": ["case-report", "receiver-receipt"] }
      }
    },
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "kind", "observations"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "label": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["information", "document", "capability", "argument", "receipt"] },
        "observations": { "type": "array", "items": { "$ref": "#/$defs/observation" } },
        "receiptContract": {
          "type": "object", "additionalProperties": false, "required": ["outcome", "receiver"],
          "properties": { "outcome": { "$ref": "#/$defs/id" }, "receiver": { "$ref": "#/$defs/id" } }
        },
        "provenance": { "type": "string" }, "limits": { "type": "string" }
      }
    },
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "proposition", "text", "sourceId", "locator", "side"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "proposition": { "$ref": "#/$defs/id" },
        "text": { "$ref": "#/$defs/id" }, "sourceId": { "$ref": "#/$defs/id" },
        "locator": { "$ref": "#/$defs/id" }, "side": { "enum": ["for", "against"] },
        "statementId": { "$ref": "#/$defs/id" }
      }
    },
    "step": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "inputs", "output", "guards", "mode", "routeId"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "label": { "$ref": "#/$defs/id" },
        "inputs": { "$ref": "#/$defs/ids" }, "output": { "$ref": "#/$defs/id" },
        "guards": { "$ref": "#/$defs/ids" }, "routeId": { "$ref": "#/$defs/id" },
        "mode": { "enum": ["preparation", "record-request", "filing", "receiver-decision"] },
        "limits": { "type": "string" }
      }
    },
    "obligation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "claimId", "argument", "exhibits", "recoveryAttempts", "objections"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "label": { "$ref": "#/$defs/id" },
        "claimId": { "$ref": "#/$defs/id" }, "argument": { "type": "string" },
        "exhibits": { "$ref": "#/$defs/ids" }, "recoveryAttempts": { "$ref": "#/$defs/ids" },
        "exhibitAlternatives": { "type": "array", "minItems": 1, "items": { "allOf": [{ "$ref": "#/$defs/ids" }], "minItems": 1 } },
        "objections": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "research": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "priority", "resolvesNodes", "resolvesClaims", "question", "method", "checked", "stopWhen", "fallback"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "priority": { "type": "integer", "minimum": 1 },
        "resolvesNodes": { "$ref": "#/$defs/ids" }, "resolvesClaims": { "$ref": "#/$defs/ids" },
        "question": { "$ref": "#/$defs/id" }, "method": { "$ref": "#/$defs/id" },
        "checked": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "stopWhen": { "$ref": "#/$defs/id" }, "fallback": { "$ref": "#/$defs/id" }
      }
    }
  }
}
