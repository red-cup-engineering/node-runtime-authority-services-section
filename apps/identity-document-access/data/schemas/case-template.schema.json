{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "version", "files"],
  "properties": {
    "kind": {"const": "identity-case-template"},
    "version": {"const": 1},
    "files": {
      "type": "object", "additionalProperties": false,
      "required": ["case", "model", "sources", "parameters"],
      "properties": {
        "case": {"$ref": "#/$defs/filename"},
        "model": {"$ref": "#/$defs/filename"},
        "sources": {"$ref": "#/$defs/filename"},
        "parameters": {"$ref": "#/$defs/filename"}
      }
    }
  },
  "$defs": {"filename": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*[.]json$"}}
}
