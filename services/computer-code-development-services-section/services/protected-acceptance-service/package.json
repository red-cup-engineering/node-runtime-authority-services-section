{
  "name": "@red-cup-engineering/protected-acceptance-service",
  "version": "1.0.4",
  "private": true,
  "type": "module",
  "description": "Sovereign die that assays and seals one protected software-acceptance capsule.",
  "exports": {
    ".": "./src/client.mjs",
    "./client": "./src/client.mjs",
    "./acceptance-capsule": "./src/acceptance-capsule.mjs"
  },
  "files": [
    "src/acceptance-capsule.mjs",
    "src/client.mjs"
  ],
  "scripts": {
    "check": "node --check src/acceptance-capsule.mjs && node --check src/client.mjs",
    "test": "node --test test/acceptance-capsule.test.mjs",
    "verify": "npm run check && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@red-cup-engineering/semantic-content-identify-service": "0.2.2",
    "@red-cup-engineering/sandbox-command-execution-service": "1.0.0"
  }
}
