[Unit]
Description=Recursive observation circuit synthesis A2A provider
After=network-online.target witness-journal-rdf-projection-service.service
Wants=network-online.target witness-journal-rdf-projection-service.service

[Service]
Type=simple
WorkingDirectory=/home/emsenn/info/lib/emsenn/services/561-group/services/red-cup-engineering/services/software-services-section/services/recursive-observation-circuit-synthesis
Environment=HOST=127.0.0.1
Environment=PORT=19824
Environment=BASE_URL=http://127.0.0.1:19824
Environment=WITNESS_JOURNAL_RDF_AGENT=http://127.0.0.1:19764/.well-known/agent-card.json
Environment=AGENT_CARD_SIGNING_KEY=/home/emsenn/info/lib/emsenn/services/561-group/services/red-cup-engineering/services/software-services-section/services/recursive-observation-circuit-synthesis/data/agent-card-signing/ed25519-private.pem
Environment=AGENT_CARD_JWKS=/home/emsenn/info/lib/emsenn/services/561-group/services/red-cup-engineering/services/software-services-section/services/recursive-observation-circuit-synthesis/content/agent-card-signing/jwks.json
Environment=AGENT_CARD_SIGNING_KID=recursive-observation-circuit-synthesis-ed25519
ExecStart=/home/emsenn/.config/nvm/versions/node/v24.13.1/bin/node bin/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
