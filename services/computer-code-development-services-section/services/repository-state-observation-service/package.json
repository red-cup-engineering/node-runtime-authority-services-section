{
  "name": "@red-cup-engineering/repository-state-observation-service",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "description": "Repository observation service using standard Git commands.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/computer-code-engineering-services-section.git",
    "directory": "services/computer-code-development-services-section/services/repository-state-observation-service"
  },
  "exports": {
    ".": "./src/client.mjs",
    "./client": "./src/client.mjs",
    "./executor": "./src/a2a-executor.mjs"
  },
  "bin": {
    "execute-repository-state-observation-a2a-message": "./scripts/execute-a2a-message.mjs",
    "serve-repository-state-observation-a2a": "./scripts/serve-a2a.mjs"
  },
  "scripts": {
    "check": "node --check src/git-command.mjs && node --check src/observer.mjs && node --check src/a2a-executor.mjs && node --check src/client.mjs && node --check scripts/execute-a2a-message.mjs && node --check scripts/serve-a2a.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.0.0-beta.0",
    "@lenticule-science/witness-journal-rdf-projection-service": "workspace:*",
    "@red-cup-engineering/a2a-contracted-agent-service": "workspace:*",
    "@red-cup-engineering/a2a-rmn-part-service": "workspace:*",
    "@red-cup-engineering/a2a-rmn-task-client-service": "workspace:*",
    "@red-cup-engineering/relation-model-notation-json-codec": "workspace:*",
    "@red-cup-engineering/relation-model-notation-typing": "workspace:*",
    "@red-cup-engineering/semantic-content-identify-service": "workspace:*",
    "@red-cup-engineering/uri-services-section": "workspace:*"
  }
}
