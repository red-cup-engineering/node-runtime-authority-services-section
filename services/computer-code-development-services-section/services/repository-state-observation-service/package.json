{
  "name": "@red-cup-engineering/repository-state-observation-service",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "description": "Repository observation service using standard Git commands.",
  "exports": {
    ".": "./src/client.mjs",
    "./client": "./src/client.mjs",
    "./executor": "./src/a2a-executor.mjs"
  },
  "bin": {
    "execute-repository-state-observation-a2a-message": "./scripts/execute-a2a-message.mjs",
    "serve-repository-state-observation-a2a": "./scripts/serve-a2a.mjs"
  },
  "scripts": {
    "check": "node --check src/git-command.mjs && node --check src/observer.mjs && node --check src/a2a-executor.mjs && node --check src/client.mjs && node --check scripts/execute-a2a-message.mjs && node --check scripts/serve-a2a.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.0.0-beta.0",
    "@lenticule-science/witness-journal-rdf-projection-service": "1.0.3",
    "@red-cup-engineering/a2a-contracted-agent-service": "2.0.5",
    "@red-cup-engineering/a2a-rmn-part-service": "1.0.1",
    "@red-cup-engineering/a2a-rmn-task-client-service": "1.1.1",
    "@red-cup-engineering/ni-uri-services-section": "0.1.1",
    "@red-cup-engineering/relation-model-notation-json-codec": "0.0.2",
    "@red-cup-engineering/relation-model-notation-typing": "0.0.1",
    "@red-cup-engineering/semantic-content-identify-service": "0.2.2"
  }
}
