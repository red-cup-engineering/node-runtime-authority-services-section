[Unit]
Description=Tensor circuit board synthesis A2A provider
Requires=tensor-circuit-board-synthesis-service.socket
After=network-online.target witness-journal-rdf-projection-service.service tensor-circuit-board-synthesis-service.socket
Wants=network-online.target witness-journal-rdf-projection-service.service

[Service]
Type=simple
Sockets=tensor-circuit-board-synthesis-service.socket
WorkingDirectory=/home/emsenn/info/lib/emsenn/services/561-group/services/red-cup-engineering/services/software-services-section/services/tensor-circuit-board-synthesis-service
Environment=BASE_URL=http://127.0.0.1:19848
Environment=WITNESS_JOURNAL_RDF_AGENT=http://127.0.0.1:19764/.well-known/agent-card.json
Environment=AGENT_CARD_SIGNING_KEY=/home/emsenn/info/lib/emsenn/services/561-group/services/red-cup-engineering/services/software-services-section/services/tensor-circuit-board-synthesis-service/data/agent-card-signing/ed25519-private.pem
Environment=AGENT_CARD_JWKS=/home/emsenn/info/lib/emsenn/services/561-group/services/red-cup-engineering/services/software-services-section/services/tensor-circuit-board-synthesis-service/content/agent-card-signing/jwks.json
Environment=AGENT_CARD_SIGNING_KID=tensor-circuit-board-synthesis-service-ed25519
ExecStart=/home/emsenn/.config/nvm/versions/node/v24.13.1/bin/node bin/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
