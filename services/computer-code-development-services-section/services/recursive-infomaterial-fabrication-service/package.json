{
  "name": "@red-cup-engineering/recursive-infomaterial-fabrication-service",
  "version": "3.0.1",
  "private": true,
  "type": "module",
  "description": "Material-free recursive board conductor requiring independent M1/FOUR equivalence before provider execution.",
  "exports": {
    ".": "./src/fabricate.mjs",
    "./client": "./src/client.mjs",
    "./request": "./src/request.mjs"
  },
  "bin": {
    "fabricate-directory-patch": "./scripts/fabricate-directory-patch.mjs"
  },
  "scripts": {
