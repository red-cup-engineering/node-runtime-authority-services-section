[Unit]
Description=Signed immutable induction evidence read A2A node
Requires=immutable-induction-evidence-read-node.socket
After=network-online.target immutable-induction-evidence-read-node.socket

[Service]
Type=simple
Sockets=immutable-induction-evidence-read-node.socket
WorkingDirectory=/home/emsenn/info/lib/emsenn/services/561-group/services/red-cup-engineering/services/software-services-section/services/accepted-software-delivery-receiver-service
Environment=BASE_URL=http://127.0.0.1:19853
Environment=IMMUTABLE_EVIDENCE_RECEIVER_AGENT=http://127.0.0.1:19853/.well-known/agent-card.json
Environment=AGENT_CARD_SIGNING_KEY=/home/emsenn/info/lib/emsenn/services/561-group/services/red-cup-engineering/services/software-services-section/services/accepted-software-delivery-receiver-service/data/agent-card-signing/ed25519-private.pem
Environment=AGENT_CARD_JWKS=/home/emsenn/info/lib/emsenn/services/561-group/services/red-cup-engineering/services/software-services-section/services/accepted-software-delivery-receiver-service/content/agent-card-signing/jwks.json
Environment=AGENT_CARD_SIGNING_KID=accepted-software-delivery-receiver-service-ed25519
Environment=IMMUTABLE_EVIDENCE_RECEIVER_IDENTITY=/home/emsenn/info/lib/emsenn/services/561-group/services/red-cup-engineering/services/software-services-section/services/accepted-software-delivery-receiver-service/content/deployment/immutable-evidence-receiver-identity.json
Environment=IMMUTABLE_EVIDENCE_DATA_ROOT=/home/emsenn/info/lib/emsenn/services/561-group/services/red-cup-engineering/services/software-services-section/services/accepted-software-delivery-receiver-service/data
Environment=IMMUTABLE_EVIDENCE_ROUTES=/home/emsenn/info/lib/emsenn/services/561-group/services/red-cup-engineering/services/software-services-section/services/accepted-software-delivery-receiver-service/content/deployment/immutable-evidence-routes.json
Environment=IMMUTABLE_EVIDENCE_SIGNING_KEY=/home/emsenn/info/lib/emsenn/services/561-group/services/red-cup-engineering/services/software-services-section/services/accepted-software-delivery-receiver-service/data/agent-card-signing/ed25519-private.pem
Environment=IMMUTABLE_EVIDENCE_SIGNING_KID=accepted-software-delivery-receiver-service-ed25519
Environment=IMMUTABLE_EVIDENCE_SIGNING_JWKS=http://127.0.0.1:19853/.well-known/jwks.json
Environment=IMMUTABLE_EVIDENCE_VERIFYING_JWKS=/home/emsenn/info/lib/emsenn/services/561-group/services/red-cup-engineering/services/software-services-section/services/accepted-software-delivery-receiver-service/content/agent-card-signing/jwks.json
ExecStart=/home/emsenn/.config/nvm/versions/node/v24.13.1/bin/node bin/serve-immutable-induction-evidence-a2a.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/emsenn/info/lib/emsenn/services/561-group/services/red-cup-engineering/services/software-services-section/services/accepted-software-delivery-receiver-service/data
UMask=0077

[Install]
WantedBy=default.target
