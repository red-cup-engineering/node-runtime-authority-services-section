{
  "name": "@red-cup-engineering/package-test-plan",
  "version": "0.1.0",
  "type": "module",
  "description": "The one test plan of a house package: its tests, their declared requirements, and the code check reads; with the run-package-tests and check-package-syntax runners.",
  "license": "UNLICENSED",
  "exports": {
    ".": "./src/package-test-plan.mjs",
    "./package-files": "./src/package-files.mjs"
  },
  "bin": {
    "run-package-tests": "./scripts/run-package-tests.mjs",
    "check-package-syntax": "./scripts/check-package-syntax.mjs"
  },
  "files": [
    "src",
    "scripts",
    "package.json"
  ],
  "scripts": {
    "test": "node scripts/run-package-tests.mjs",
    "check": "node scripts/check-package-syntax.mjs"
  }
}
