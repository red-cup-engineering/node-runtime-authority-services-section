rce policy, not a remaining blocker. Manifest and lock unchanged from main24bb6ced. Independent source review completed; draft status retained pending existing integration rules. No release, deployment, installed host receiving or Graph package qualification claimed.","labels":[],"milestone":null,"active_lock_reason":null,"created_at":"2026-10-21T00:38:30Z","updated_at":"2026-10-21T04:39:46Z","closed_at":"2026-10-21T03:08:07Z","merged_at":"2026-10-21T03:08:07Z","merge_commit_sha":"29bd16f1394553afb075f6951d9779503e0432e7","assignee":null,"assignees":[],"requested_reviewers":[],"requested_teams":[],"head":{"label":"red-cup-engineering:fix/install-input-custody-20261021","ref":"fix/install-input-custody-20261021","repo":{"id":1421405554,"node_id":"R_kgDOVLjtcg","name":"npm-workspace-publication-service","full_name":"red-cup-engineering/npm-workspace-publication-service","owner":{"login":"red-cup-engineering","id":308933773,"node_id":"O_kgDOEmn0jQ","avatar_url":"https://avatars.githubusercontent.com/u/308933773?v=4","gravatar_id":"","url":"https://api.github.com/users/red-cup-engineering","html_url":"https://github.com/red-cup-engineering","followers_url":"https://api.github.com/users/red-cup-engineering/followers","following_url":"https://api.github.com/users/red-cup-engineering/following{/other_user}","gists_url":"https://api.github.com/users/red-cup-engineering/gists{/gist_id}","starred_url":"https://api.github.com/users/red-cup-engineering/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/red-cup-engineering/subscriptions","organizations_url":"https://api.github.com/users/red-cup-engineering/orgs","repos_url":"https://api.github.com/users/red-cup-engineering/repos","events_url":"https://api.github.com/users/red-cup-engineering/events{/privacy}","received_events_url":"https://api.github.com/users/red-cup-engineering/received_events","type":"Organization","user_view_type":"public","site_admin":false},"private":true,"fork":false,"archived":fals