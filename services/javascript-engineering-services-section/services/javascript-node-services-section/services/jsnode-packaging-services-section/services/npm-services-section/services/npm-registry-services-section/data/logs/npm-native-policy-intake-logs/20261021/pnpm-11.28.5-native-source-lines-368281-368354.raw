async function getConfig2(cliOptions, opts3) {
  const warnings = [];
  try {
    const { config: config2, context } = await getConfig({
      cliOptions,
      globalDirShouldAllowWrite: opts3.globalDirShouldAllowWrite,
      skipGlobalBinDirCheck: opts3.skipGlobalBinDirCheck,
      packageManager,
      workspaceDir: opts3.workspaceDir,
      onlyInheritDlxSettingsFromLocal: opts3.onlyInheritDlxSettingsFromLocal,
      forSelfUpdate: opts3.forSelfUpdate,
      ignoreProjectNpmrc: opts3.ignoreProjectNpmrc,
      warnings
    });
    context.cliOptions = cliOptions;
    context.rawCliConfig = opts3.rawCliConfig;
    applyDerivedConfig(config2);
    if (opts3.excludeReporter) {
      delete config2.reporter;
    }
    return { config: config2, context };
  } finally {
    if (opts3.printWarnings !== false && warnings.length > 0) {
      console.warn(warnings.map((warning) => formatWarn(warning)).join("\n"));
    }
  }
}
function isSingleSettingRead(cmd, cliParams) {
