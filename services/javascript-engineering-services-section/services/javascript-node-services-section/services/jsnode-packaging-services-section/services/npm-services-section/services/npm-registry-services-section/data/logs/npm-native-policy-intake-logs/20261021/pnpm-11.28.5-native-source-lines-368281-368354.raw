}
async function installConfigDeps2(config2, context, opts3) {
  const store = await createStoreController({ ...config2, ...context, skipBypassedHomeStoreWarning: true });
  try {
    await resolveAndInstallConfigDeps(opts3.configDependencies, {
      ...config2,
