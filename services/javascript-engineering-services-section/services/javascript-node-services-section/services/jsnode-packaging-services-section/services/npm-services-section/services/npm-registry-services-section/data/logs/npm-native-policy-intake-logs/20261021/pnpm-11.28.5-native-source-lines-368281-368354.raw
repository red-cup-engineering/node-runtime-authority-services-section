async function installConfigDepsAndLoadHooks(config2, context, opts3) {
  let configDependenciesVerified = false;
  if (config2.configDependencies) {
    configDependenciesVerified = await installConfigDeps2(config2, context, {
      configDependencies: config2.configDependencies,
      tolerateErrors: opts3?.tolerateConfigDependenciesErrors
    });
  }
  if (config2.ignorePnpmfile) {
