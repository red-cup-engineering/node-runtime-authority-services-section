<html>
  <body>
    <h1>Debug Page</h1>
    <main>
    <section>
      <h2>Server Information</h2>
      <dl>
	{{#base-url}}
	  <dt>Base URL (<code>base-url</code>)</dt>
	  <dd>{{base-url}}</dd>
	{{/base-url}}
      </dl>
    </section>
    <section>
      <h2>Actor Information</h2>
      <dl>
	{{#username}}
	  <dt>Username (<code>user-name</code>)</dt>
	  <dd>{{username}}</dd>
	{{/username}}
	{{#make-things}}
	  <dt>Things You Make (<code>make-things</code>)</dt>
	  {{#make-things}}
	    <dd>{{thing}}</dd>
	  {{/make-things}}
	  {{/make-things}}
      </dl>
    </section>
    </main>
  </body>
</html>
