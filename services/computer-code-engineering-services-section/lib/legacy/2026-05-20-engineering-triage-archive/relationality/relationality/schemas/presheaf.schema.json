{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Presheaf",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "site_id",
    "objects",
    "arrows",
    "covers",
    "sections",
    "restrictions",
    "commutation_checks"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "presheaf"
    },
    "site_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "arrows": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "covers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "object",
          "arrows"
        ],
        "properties": {
          "object": {
            "type": "string"
          },
          "arrows": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "sections": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      }
    },
    "restrictions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "map"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "map": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    },
    "commutation_checks": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    }
  }
}
