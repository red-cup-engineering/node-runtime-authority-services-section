{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvalContextSeed",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "trace_id",
    "hole_position",
    "surrounding_context",
    "typing_ref"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "eval_context_seed"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "hole_position": {
      "type": "integer",
      "minimum": 0
    },
    "surrounding_context": {
      "type": "object"
    },
    "typing_ref": {
      "type": "string"
    }
  }
}

