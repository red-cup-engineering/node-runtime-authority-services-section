{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "System",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "flow_map_id",
    "nucleus_map_id",
    "profile_topos_id",
    "phase_space_id",
    "measurement_frame_id",
    "regime_id",
    "trace_id",
    "fixed_invariants_id"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "system"
    },
    "flow_map_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nucleus_map_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "profile_topos_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "phase_space_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "measurement_frame_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "regime_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "fixed_invariants_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
