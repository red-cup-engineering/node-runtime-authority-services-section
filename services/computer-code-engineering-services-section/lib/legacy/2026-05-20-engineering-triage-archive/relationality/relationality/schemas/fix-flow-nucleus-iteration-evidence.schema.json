{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FixFlowNucleusIterationEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "flow_id",
    "nucleus_id",
    "carrier_id",
    "start_element",
    "iteration_count",
    "last_states",
    "commutation_evidence_id",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "fix_flow_nucleus_iteration_evidence"
    },
    "flow_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nucleus_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "carrier_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "start_element": {
      "type": "string"
    },
    "iteration_count": {
      "type": "integer",
      "minimum": 0
    },
    "last_states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "commutation_evidence_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "counterexample": {
      "type": "object"
    },
    "act_ref": {
      "type": "string"
    }
  }
}
