{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProfileEntropy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "profile_id",
    "entropy_values",
    "act_ref"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "profile_entropy"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "entropy_values": {
      "type": "object",
      "patternProperties": {
        ".*": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "act_ref": {
      "type": "string"
    }
  }
}

