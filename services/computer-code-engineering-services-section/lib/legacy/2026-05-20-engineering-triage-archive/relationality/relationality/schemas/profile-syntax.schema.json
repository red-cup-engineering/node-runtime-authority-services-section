{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProfileSyntax",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "profile_topos_id",
    "profile_semantics_id",
    "term_ids",
    "judgment_ids",
    "act_ref"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "profile_syntax"
    },
    "profile_topos_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "profile_semantics_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "term_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "uniqueItems": true
    },
    "judgment_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "uniqueItems": true
    },
    "act_ref": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  }
}

