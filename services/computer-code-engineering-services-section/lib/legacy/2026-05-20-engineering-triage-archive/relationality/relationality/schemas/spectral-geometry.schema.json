{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SpectralGeometry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "basis",
    "operator_matrices",
    "spectral_weights",
    "harmonic_modes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "spectral_geometry"
    },
    "basis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "operator_matrices": {
      "type": "object",
      "description": "Operator matrices on the finite basis; entries are JSON strings representing exact rational scalars.",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "spectral_weights": {
      "type": "object",
      "description": "Spectral weights (λ) for each operator; arrays of JSON strings representing exact rational scalars, sorted in non-decreasing order.",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      }
    },
    "harmonic_modes": {
      "type": "object",
      "description": "Harmonic modes (v) for each operator; arrays of arrays of JSON strings representing exact rational scalars, each mode unit-normalized.",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": true
    },
    "parameters": {
      "type": "object",
      "additionalProperties": true
    },
    "act_ref": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  }
}
