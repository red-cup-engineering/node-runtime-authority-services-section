{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SystemLawsEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "system_id",
    "profile_topos_id",
    "phase_space_id",
    "measurement_frame_id",
    "regime_id",
    "trace_id",
    "fixed_invariants_id",
    "flow_map_id",
    "nucleus_map_id",
    "observation_equivalence_id",
    "checks",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "system_laws_evidence"
    },
    "system_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "profile_topos_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "phase_space_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "measurement_frame_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "regime_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "fixed_invariants_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "flow_map_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nucleus_map_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "observation_equivalence_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_phase_fixed_lattice_alignment",
        "flow_nucleus_carrier_alignment",
        "fixed_invariants_fixed_points",
        "measurement_frame_recognition_alignment",
        "observation_equivalence_coverage",
        "trace_alignment",
        "regime_operator_completeness"
      ],
      "properties": {
        "profile_phase_fixed_lattice_alignment": {
          "type": "boolean"
        },
        "flow_nucleus_carrier_alignment": {
          "type": "boolean"
        },
        "fixed_invariants_fixed_points": {
          "type": "boolean"
        },
        "measurement_frame_recognition_alignment": {
          "type": "boolean"
        },
        "observation_equivalence_coverage": {
          "type": "boolean"
        },
        "trace_alignment": {
          "type": "boolean"
        },
        "regime_operator_completeness": {
          "type": "boolean"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "counterexample": {
      "type": "object"
    },
    "act_ref": {
      "type": "string"
    }
  }
}

