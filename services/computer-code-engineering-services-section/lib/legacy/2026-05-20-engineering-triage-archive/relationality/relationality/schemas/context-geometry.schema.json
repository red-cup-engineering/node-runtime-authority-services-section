{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ContextGeometry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "site_id",
    "geometry",
    "act_ref"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "context_geometry"
    },
    "site_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "geometry": {
      "type": "object"
    },
    "act_ref": {
      "type": "string"
    }
  }
}

