{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvaluationEquivalence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "input_ids",
    "witness_ids"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "evaluation_equivalence"
    },
    "input_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "equivalence_classes": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "relation_table": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "witness_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    }
  }
}

