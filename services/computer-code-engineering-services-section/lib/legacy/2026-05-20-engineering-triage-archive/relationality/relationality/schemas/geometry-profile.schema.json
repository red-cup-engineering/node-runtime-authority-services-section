{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GeometryProfile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "profile_topos_id",
    "flow_map_id",
    "nucleus_map_id",
    "flow_laws_evidence_id",
    "nucleus_laws_evidence_id",
    "commutation_evidence_id"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "geometry_profile"
    },
    "profile_topos_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "flow_map_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nucleus_map_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "flow_laws_evidence_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nucleus_laws_evidence_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "commutation_evidence_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "act_ref": {
      "type": "string"
    }
  }
}

