{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProfileSemanticsEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "profile_topos_id",
    "checks",
    "status",
    "act_ref"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "profile_semantics_evidence"
    },
    "profile_topos_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "checks": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "counterexample": {
      "type": "object"
    },
    "act_ref": {
      "type": "string"
    }
  }
}

