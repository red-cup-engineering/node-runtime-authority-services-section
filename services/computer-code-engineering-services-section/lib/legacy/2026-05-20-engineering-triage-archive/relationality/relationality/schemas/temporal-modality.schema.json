{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TemporalModality",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "basis",
    "always_table",
    "eventually_table",
    "flow_ref",
    "nucleus_ref",
    "fix_ref"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "temporal_modality"
    },
    "basis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "always_table": {
      "type": "object",
      "patternProperties": {
        ".*": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "eventually_table": {
      "type": "object",
      "patternProperties": {
        ".*": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "flow_ref": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nucleus_ref": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "fix_ref": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "act_ref": {
      "type": "string"
    }
  }
}

