{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FixedObserveEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "observation_id",
    "fixed_invariants_id",
    "status",
    "act_ref"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "fixed_observe_evidence"
    },
    "observation_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "fixed_invariants_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "counterexample": {
      "type": "object"
    },
    "act_ref": {
      "type": "string"
    }
  }
}

