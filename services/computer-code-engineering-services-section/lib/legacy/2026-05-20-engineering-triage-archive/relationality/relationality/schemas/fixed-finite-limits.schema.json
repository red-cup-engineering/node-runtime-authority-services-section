{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FixedFiniteLimits",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "fixed_invariants_id",
    "terminal"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "fixed_finite_limits"
    },
    "fixed_invariants_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "terminal": {
      "type": "string"
    },
    "products": {
      "type": "object",
      "patternProperties": {
        ".*": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "act_ref": {
      "type": "string"
    }
  }
}

