{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TemporalModalityEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "temporal_modality_id",
    "residuation_table",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "temporal_modality_evidence"
    },
    "temporal_modality_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "residuation_table": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "x",
          "y",
          "always_x",
          "eventually_y",
          "lhs",
          "rhs"
        ],
        "properties": {
          "x": {
            "type": "string"
          },
          "y": {
            "type": "string"
          },
          "always_x": {
            "type": "string"
          },
          "eventually_y": {
            "type": "string"
          },
          "lhs": {
            "type": "boolean"
          },
          "rhs": {
            "type": "boolean"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "counterexample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "always_x",
        "eventually_y",
        "lhs",
        "rhs"
      ],
      "properties": {
        "x": {
          "type": "string"
        },
        "y": {
          "type": "string"
        },
        "always_x": {
          "type": "string"
        },
        "eventually_y": {
          "type": "string"
        },
        "lhs": {
          "type": "boolean"
        },
        "rhs": {
          "type": "boolean"
        }
      }
    },
    "act_ref": {
      "type": "string"
    }
  }
}

