{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReducibilityCandidates",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "context_id",
    "candidates"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "reducibility_candidates"
    },
    "context_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidates": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "term_id",
          "typing_witness_id",
          "normalization_witness_id"
        ],
        "properties": {
          "term_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "typing_witness_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "normalization_witness_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}

