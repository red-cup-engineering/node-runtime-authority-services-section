{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CommutationEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "carrier_id",
    "flow_id",
    "nucleus_id",
    "table",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "commutation_evidence"
    },
    "carrier_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "flow_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nucleus_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "table": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "element",
          "flow_then_nucleus",
          "nucleus_then_flow"
        ],
        "properties": {
          "element": {
            "type": "string"
          },
          "flow_then_nucleus": {
            "type": "string"
          },
          "nucleus_then_flow": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "counterexample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "element",
        "flow_then_nucleus",
        "nucleus_then_flow"
      ],
      "properties": {
        "element": {
          "type": "string"
        },
        "flow_then_nucleus": {
          "type": "string"
        },
        "nucleus_then_flow": {
          "type": "string"
        }
      }
    },
    "act_ref": {
      "type": "string"
    }
  }
}
