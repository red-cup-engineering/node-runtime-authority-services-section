{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FixedKernel",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "basis",
    "kernel_matrix",
    "stationarity_evidence",
    "act_ref"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "fixed_kernel"
    },
    "basis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "kernel_matrix": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      }
    },
    "stationarity_evidence": {
      "type": "object",
      "required": [
        "space_average",
        "observation_kernel_id"
      ],
      "properties": {
        "space_average": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "observation_kernel_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "act_ref": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  }
}
