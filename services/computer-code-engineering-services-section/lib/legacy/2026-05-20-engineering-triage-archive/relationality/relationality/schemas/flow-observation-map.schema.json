{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FlowObservationMap",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "observation_carrier_id",
    "flow_table",
    "act_ref"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "flow_observation_map"
    },
    "observation_carrier_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "flow_table": {
      "type": "object",
      "description": "Flow table on a finite set of observation IDs; total, single-valued map.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "act_ref": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  }
}

