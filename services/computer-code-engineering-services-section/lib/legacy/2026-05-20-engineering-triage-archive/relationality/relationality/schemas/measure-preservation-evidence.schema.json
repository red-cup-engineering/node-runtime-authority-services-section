{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MeasurePreservationEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "operator_ref",
    "status",
    "witnesses",
    "act_ref"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "measure_preservation_evidence"
    },
    "operator_ref": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "preserving",
        "dissipative",
        "fail"
      ]
    },
    "witnesses": {
      "type": "object"
    },
    "act_ref": {
      "type": "string"
    }
  }
}

