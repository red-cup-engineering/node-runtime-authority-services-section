{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProfileContext",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "profile_topos_id",
    "profile_semantics_id",
    "act_ref"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "profile_context"
    },
    "profile_topos_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "profile_semantics_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "act_ref": {
      "type": "string"
    }
  }
}

