{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SyntaxRecognitionEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "syntax_id",
    "witnesses",
    "status",
    "act_ref"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "syntax_recognition_evidence"
    },
    "syntax_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "witnesses": {
      "type": "object"
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "act_ref": {
      "type": "string"
    }
  }
}

