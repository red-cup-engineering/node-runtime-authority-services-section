{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MixingEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "profile_id",
    "entropy_path",
    "independence_witness",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "mixing_evidence"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "entropy_path": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "independence_witness": {
      "type": "object"
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "counterexample": {
      "type": "object"
    },
    "act_ref": {
      "type": "string"
    }
  }
}
