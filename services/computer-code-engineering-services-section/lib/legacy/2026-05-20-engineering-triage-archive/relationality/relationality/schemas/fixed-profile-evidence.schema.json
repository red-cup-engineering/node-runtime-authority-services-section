{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FixedProfileEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "profile_topos_id",
    "flow_map_id",
    "nucleus_map_id",
    "status",
    "act_ref"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "fixed_profile_evidence"
    },
    "profile_topos_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "flow_map_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nucleus_map_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "type": "string",
      "enum": ["pass", "fail"]
    },
    "counterexample": {
      "type": "object"
    },
    "act_ref": {
      "type": "string"
    }
  }
}

