{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ErgodicityEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "trace_id",
    "fixed_kernel_id",
    "mixing_evidence_id",
    "time_average",
    "space_average",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "ergodicity_evidence"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "fixed_kernel_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "mixing_evidence_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "time_average": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "space_average": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "counterexample": {
      "type": "object",
      "required": [
        "index",
        "time_value",
        "space_value"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "time_value": {
          "type": "string"
        },
        "space_value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "act_ref": {
      "type": "string"
    }
  }
}
