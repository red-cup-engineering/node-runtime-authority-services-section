{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MeasurementFrame",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "admissible_observations",
    "kernel_params",
    "constraints",
    "act_version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "measurement_frame"
    },
    "admissible_observations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "kernel_params": {
      "type": "object",
      "additionalProperties": true
    },
    "constraints": {
      "type": "object",
      "additionalProperties": true
    },
    "act_version": {
      "type": "string"
    }
  }
}
