{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Regime",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "allowed_operators",
    "suppressed_operators",
    "invariant_constraints"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "regime"
    },
    "allowed_operators": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "suppressed_operators": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "invariant_constraints": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
