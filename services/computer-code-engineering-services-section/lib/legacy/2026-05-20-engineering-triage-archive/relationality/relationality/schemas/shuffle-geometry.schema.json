{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ShuffleGeometry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "shuffle_profile_id",
    "geometry_tags",
    "act_ref"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "shuffle_geometry"
    },
    "shuffle_profile_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "geometry_tags": {
      "type": "object",
      "patternProperties": {
        ".*": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "act_ref": {
      "type": "string"
    }
  }
}

