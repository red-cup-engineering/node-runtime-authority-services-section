{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SyntaxNormalForm",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "term_id",
    "normal_form",
    "normalization_witness_id",
    "act_ref"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "syntax_normal_form"
    },
    "term_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "normal_form": {
      "type": "object"
    },
    "normalization_witness_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "act_ref": {
      "type": "string"
    }
  }
}

