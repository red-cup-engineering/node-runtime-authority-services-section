{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Trace Evidence",
  "type": "object",
  "required": ["id", "kind", "status", "issues", "checks", "trace_id"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "trace_evidence"
    },
    "status": {
      "type": "string",
      "enum": ["pass", "fail"]
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["law", "status"],
        "properties": {
          "law": {"type": "string"},
          "status": {"type": "string", "enum": ["pass", "fail"]},
          "counterexample": {"type": ["object", "null"]}
        },
        "additionalProperties": false
      }
    },
    "kernel_pairs": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
