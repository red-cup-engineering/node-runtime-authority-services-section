{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FixedOperator",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "carrier_id",
    "elements",
    "operator_table"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "fixed_operator"
    },
    "carrier_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "elements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "operator_table": {
      "type": "object",
      "patternProperties": {
        ".*": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "act_ref": {
      "type": "string"
    }
  }
}

