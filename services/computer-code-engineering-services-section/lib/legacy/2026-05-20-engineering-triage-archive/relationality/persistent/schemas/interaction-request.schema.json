{
  "$id": "https://relationality.local/schemas/interaction-request.schema.json",
  "title": "System Interaction Request",
  "type": "object",
  "required": ["observation"],
  "properties": {
    "observation": {
      "description": "External ObservationCarrier payload; must satisfy observation-carrier schema when embedded.",
      "type": "object"
    },
    "intent": {
      "type": "string",
      "enum": ["default", "read_only", "predict", "invariants_only"],
      "default": "default"
    },
    "constraints": {
      "type": "object"
    },
    "trace_context": {
      "type": "object"
    }
  },
  "additionalProperties": false
}