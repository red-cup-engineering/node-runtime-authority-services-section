{
  "$id": "https://relationality.local/schemas/realizer.schema.json",
  "title": "Realizer Metadata",
  "description": "Metadata for Python operator kernels implementing act-level moves.",
  "type": "object",
  "required": ["id", "act", "module", "callable", "input_kind", "output_kind"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "act": {
      "type": "string",
      "description": "Act/operator realized by this kernel."
    },
    "module": {
      "type": "string",
      "description": "Python module path under realizers.py namespace."
    },
    "callable": {
      "type": "string",
      "description": "Callable name within the module."
    },
    "input_kind": {
      "type": "string"
    },
    "output_kind": {
      "type": "string"
    },
    "invariants": {
      "type": "array",
      "items": {"type": "string"}
    },
    "description": {
      "type": "string"
    }
  },
  "additionalProperties": false
}