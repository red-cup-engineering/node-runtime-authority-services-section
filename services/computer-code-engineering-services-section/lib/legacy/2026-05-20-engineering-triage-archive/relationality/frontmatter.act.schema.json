{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Frontmatter Schema: Act",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "role", "status", "top", "bottom"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9-]+$"},
    "title": {"type": "string"},
    "role": {"const": "act"},
    "status": {"type": "string", "enum": ["plan", "draft", "stable", "deprecated"]},
    "top": {"type": "string", "description": "upstream act id (composition head)"},
    "bottom": {"type": "string", "description": "upstream act id (composition tail)"},
    "slug": {"type": "string"},
    "invariants": {
      "type": "array",
      "items": {"type": "string"},
      "description": "statements this act enforces in the hypertensor topos"
    },
    "description": {"type": "string", "description": "brief act description"}
  }
}
