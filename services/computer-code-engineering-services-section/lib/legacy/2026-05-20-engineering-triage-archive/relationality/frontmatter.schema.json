{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Frontmatter Schema for Structures and Operators",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9-]+$"},
    "title": {"type": "string"},
    "role": {"type": "string", "enum": ["structure", "operator"]},
    "status": {"type": "string", "enum": ["plan", "draft", "stable", "deprecated"]},
    "proof_refs": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "emerges_from": {"type": "string"},
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string"},
          "type": {"type": "string"},
          "description": {"type": "string"}
        },
        "required": ["name", "type", "description"]
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "alias": {"type": "string"}
        },
        "required": ["id", "alias"]
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "alias": {"type": "string"}
        },
        "required": ["id", "alias"]
      }
    },
    "transformation": {
      "type": "array",
      "items": {}
    }
  },
  "oneOf": [
    {
      "title": "Structure",
      "properties": {
        "role": {"const": "structure"}
      },
      "required": ["id", "title", "role", "status", "fields"],
      "not": {"required": ["inputs", "outputs", "transformation"]}
    },
    {
      "title": "Operator",
      "properties": {
        "role": {"const": "operator"}
      },
      "required": ["id", "title", "role", "status", "inputs", "outputs", "transformation"],
      "not": {"required": ["fields", "emerges_from"]}
    }
  ]
}
