{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Frontmatter Schema: Structure",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "role", "status", "fields"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9-]+$"},
    "title": {"type": "string"},
    "role": {"const": "structure"},
    "status": {"type": "string", "enum": ["plan", "draft", "stable", "deprecated"]},
    "emerges_from": {"type": "string"},
    "proof_refs": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "description"],
        "properties": {
          "name": {"type": "string"},
          "type": {"type": "string"},
          "description": {"type": "string"}
        }
      }
    }
  }
}
