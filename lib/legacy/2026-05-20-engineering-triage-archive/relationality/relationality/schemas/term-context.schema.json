{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TermContext",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "variables",
    "types",
    "discipline_refs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "term_context"
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "discipline_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}

