{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PresheafSite",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "objects",
    "arrows",
    "identity",
    "composition",
    "covers"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "presheaf_site"
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "arrows": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        ".*": {
          "type": "string"
        }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        ".*": {
          "type": "string"
        }
      }
    },
    "covers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "object",
          "arrows"
        ],
        "properties": {
          "object": {
            "type": "string"
          },
          "arrows": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}

