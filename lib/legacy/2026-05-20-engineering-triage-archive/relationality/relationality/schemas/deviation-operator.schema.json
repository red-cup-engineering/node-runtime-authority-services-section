{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DeviationOperator",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "basis",
    "operator_matrix",
    "act_ref"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "deviation_operator"
    },
    "basis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "operator_matrix": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      }
    },
    "kernel_ref": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "act_ref": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  }
}

