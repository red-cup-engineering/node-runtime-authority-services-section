{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Term",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "syntax",
    "context_id",
    "trace_id",
    "bindings"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "term"
    },
    "syntax": {
      "type": "object"
    },
    "context_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "typing_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}

