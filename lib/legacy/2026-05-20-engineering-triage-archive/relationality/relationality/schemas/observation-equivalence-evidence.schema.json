{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ObservationEquivalenceEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "equivalence_id",
    "evaluation_witnesses",
    "normalization_witnesses",
    "status",
    "act_ref"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "observation_equivalence_evidence"
    },
    "equivalence_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evaluation_witnesses": {
      "type": "object",
      "additionalProperties": true
    },
    "normalization_witnesses": {
      "type": "object",
      "additionalProperties": true
    },
    "status": {
      "type": "string",
      "enum": ["pass", "fail"]
    },
    "act_ref": {
      "type": "string"
    }
  }
}

