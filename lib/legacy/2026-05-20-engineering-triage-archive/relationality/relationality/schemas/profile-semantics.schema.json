{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProfileSemantics",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "profile_topos_id",
    "classifier_data",
    "limits_data",
    "witness_ids"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "profile_semantics"
    },
    "profile_topos_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "classifier_data": {
      "type": "object",
      "additionalProperties": true
    },
    "limits_data": {
      "type": "object",
      "additionalProperties": true
    },
    "witness_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "uniqueItems": true
    }
  }
}

