{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FixedProfile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "profile_topos_id",
    "elements"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "fixed_profile"
    },
    "profile_topos_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "elements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "act_ref": {
      "type": "string"
    }
  }
}

