{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ObservationCarrier",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "payload_schema_version",
    "payload_shape"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "observation_carrier"
    },
    "payload_schema_version": {
      "type": "string"
    },
    "payload_shape": {
      "type": "object"
    },
    "encodings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
