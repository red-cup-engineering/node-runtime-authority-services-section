{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TraceProfile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "trace_id",
    "profile_topos_id",
    "elements",
    "act_ref"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "trace_profile"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "profile_topos_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "act_ref": {
      "type": "string"
    }
  }
}

