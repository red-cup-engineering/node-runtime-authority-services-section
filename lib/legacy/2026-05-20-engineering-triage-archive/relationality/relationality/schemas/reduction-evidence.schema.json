{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReductionEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "term_before_id",
    "term_after_id",
    "trace_id",
    "redex_location",
    "typing_witness_id",
    "status",
    "act_ref"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "reduction_evidence"
    },
    "term_before_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "term_after_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "redex_location": {
      "type": "object"
    },
    "typing_witness_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "counterexample": {
      "type": "object"
    },
    "act_ref": {
      "type": "string"
    }
  }
}

