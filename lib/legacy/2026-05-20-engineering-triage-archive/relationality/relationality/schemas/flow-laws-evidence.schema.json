{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FlowLawsEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "flow_id",
    "carrier_id",
    "checks",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "flow_laws_evidence"
    },
    "flow_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "carrier_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "monotone",
        "inflationary",
        "distributive"
      ],
      "properties": {
        "monotone": {
          "type": "boolean"
        },
        "inflationary": {
          "type": "boolean"
        },
        "distributive": {
          "type": "boolean"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "counterexample": {
      "type": "object"
    },
    "act_ref": {
      "type": "string"
    }
  }
}

