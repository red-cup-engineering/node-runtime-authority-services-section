{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Trace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "elements",
    "head",
    "tail"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "trace"
    },
    "elements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "head": {
      "type": "string"
    },
    "tail": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "shuffle_metadata": {
      "type": "object",
      "properties": {
        "permutations": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "canonical_rep": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
