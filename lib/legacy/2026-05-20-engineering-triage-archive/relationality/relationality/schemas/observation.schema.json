{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "carrier_id",
    "measurement_frame_id",
    "element"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "observation"
    },
    "carrier_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "measurement_frame_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "element": {
      "type": "string"
    },
    "term_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "judgment_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "act_ref": {
      "type": "string"
    }
  }
}
