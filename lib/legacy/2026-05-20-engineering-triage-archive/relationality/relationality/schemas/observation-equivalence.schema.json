{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ObservationEquivalence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "observation_ids",
    "witness_ids",
    "equivalence_table"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "observation_equivalence"
    },
    "observation_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "equivalence_classes": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      }
    },
    "equivalence_table": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "relation_table": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "string"
        }
      }
    },
    "witness_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "uniqueItems": true
    },
    "act_version": {
      "type": "string"
    }
  }
}
