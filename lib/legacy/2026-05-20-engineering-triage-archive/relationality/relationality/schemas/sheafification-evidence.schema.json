{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SheafificationEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "presheaf_id",
    "matching_families",
    "glued_sections",
    "uniqueness_witnesses",
    "status",
    "act_ref"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "sheafification_evidence"
    },
    "presheaf_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "matching_families": {
      "type": "object"
    },
    "glued_sections": {
      "type": "object"
    },
    "uniqueness_witnesses": {
      "type": "object"
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "counterexample": {
      "type": "object"
    },
    "act_ref": {
      "type": "string"
    }
  }
}

