{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SubstitutionMap",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "context_id",
    "bindings",
    "alpha_renaming_info"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "substitution_map"
    },
    "context_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bindings": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "alpha_renaming_info": {
      "type": "object"
    },
    "typing_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    }
  }
}

