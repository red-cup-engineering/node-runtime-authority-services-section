{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SubstitutionEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "term_id",
    "substitution_map_id",
    "bindings",
    "typing_witnesses",
    "status",
    "act_ref"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "substitution_evidence"
    },
    "term_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "substitution_map_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bindings": {
      "type": "object"
    },
    "typing_witnesses": {
      "type": "object"
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "counterexample": {
      "type": "object"
    },
    "act_ref": {
      "type": "string"
    }
  }
}

