{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NucleusLawsEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "nucleus_id",
    "carrier_id",
    "checks",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "nucleus_laws_evidence"
    },
    "nucleus_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "carrier_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extensive",
        "idempotent",
        "monotone",
        "equalize",
        "absorb"
      ],
      "properties": {
        "extensive": {
          "type": "boolean"
        },
        "idempotent": {
          "type": "boolean"
        },
        "monotone": {
          "type": "boolean"
        },
        "equalize": {
          "type": "boolean"
        },
        "absorb": {
          "type": "boolean"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "counterexample": {
      "type": "object"
    },
    "act_ref": {
      "type": "string"
    }
  }
}

