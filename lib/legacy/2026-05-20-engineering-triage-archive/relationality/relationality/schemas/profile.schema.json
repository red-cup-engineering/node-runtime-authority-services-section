{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Profile",
  "type": "object",
  "required": ["id", "kind", "elements", "order", "meet", "join", "imply", "bottom", "top", "negate_map"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "profile"
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "order": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "meet": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      }
    },
    "join": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      }
    },
    "imply": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      }
    },
    "negate_map": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "bottom": {
      "type": "string"
    },
    "top": {
      "type": "string"
    },
    "classifier": {
      "type": "object",
      "properties": {
        "kind": {"const": "classifier"},
        "id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "truth": {"type": "string"},
        "false": {"type": "string"}
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "terminal": {"type": "string"}
      },
      "required": ["terminal"],
      "additionalProperties": true
    },
    "exponentials": {
      "type": "object",
      "additionalProperties": true
    },
    "flow_map": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "nucleus_map": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "flow_fixed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nucleus_fixed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "flow_nucleus_fixed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "act_ref": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
