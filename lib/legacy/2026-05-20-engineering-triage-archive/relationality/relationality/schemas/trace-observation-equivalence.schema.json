{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TraceObservationEquivalence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "trace_id",
    "observation_equivalence_id",
    "step_equivalences"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "const": "trace_observation_equivalence"
    },
    "trace_id": {
      "type": "string"
    },
    "observation_equivalence_id": {
      "type": "string"
    },
    "step_equivalences": {
      "description": "Per-element threading of NormalizeObservationEquivalence along the trace.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["element", "representative"],
        "properties": {
          "element": {
            "type": "string"
          },
          "representative": {
            "type": "string"
          }
        }
      }
    },
    "act_ref": {
      "type": "string",
      "const": "TraceObservationEquivalence"
    }
  }
}

