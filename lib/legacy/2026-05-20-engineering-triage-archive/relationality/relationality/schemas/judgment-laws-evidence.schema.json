{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JudgmentLawsEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "carrier_id",
    "law_checks",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "judgment_laws_evidence"
    },
    "carrier_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "law_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "law",
          "status"
        ],
        "properties": {
          "law": {
            "type": "string",
            "enum": [
              "order",
              "meet_join",
              "implication",
              "negation",
              "bounds"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail"
            ]
          },
          "counterexample": {
            "type": "object"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "act_ref": {
      "type": "string"
    }
  }
}

