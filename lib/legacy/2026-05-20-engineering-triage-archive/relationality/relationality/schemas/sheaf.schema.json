{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sheaf",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "presheaf_id",
    "covers",
    "gluing_families",
    "glued_sections",
    "uniqueness_witnesses"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "sheaf"
    },
    "presheaf_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "covers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cover_id",
          "object",
          "arrows"
        ],
        "properties": {
          "cover_id": {
            "type": "string"
          },
          "object": {
            "type": "string"
          },
          "arrows": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "gluing_families": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cover_id",
          "sections"
        ],
        "properties": {
          "cover_id": {
            "type": "string"
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "glued_sections": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "uniqueness_witnesses": {
      "type": "object"
    }
  }
}

