{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RunbookLawsEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "runbook_id",
    "runbook_name",
    "checks",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "runbook_laws_evidence"
    },
    "runbook_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runbook_name": {
      "type": "string"
    },
    "system_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "regime_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputs_satisfied",
        "outputs_lawful",
        "composition_typed",
        "operator_order_lawful",
        "bindings_consistent",
        "declared_outputs_match",
        "regime_respected",
        "no_illegal_transitions"
      ],
      "properties": {
        "inputs_satisfied": {
          "type": "boolean"
        },
        "outputs_lawful": {
          "type": "boolean"
        },
        "composition_typed": {
          "type": "boolean"
        },
        "operator_order_lawful": {
          "type": "boolean"
        },
        "bindings_consistent": {
          "type": "boolean"
        },
        "declared_outputs_match": {
          "type": "boolean"
        },
        "regime_respected": {
          "type": "boolean"
        },
        "no_illegal_transitions": {
          "type": "boolean"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "counterexample": {
      "type": "object"
    },
    "act_ref": {
      "type": "string"
    }
  }
}

