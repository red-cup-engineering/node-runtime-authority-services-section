{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvaluationFrame",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "trace_id",
    "hole_position",
    "frame_context",
    "typing_ref"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "evaluation_frame"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "hole_position": {
      "type": "integer",
      "minimum": 0
    },
    "frame_context": {
      "type": "object"
    },
    "typing_ref": {
      "type": "string"
    }
  }
}

