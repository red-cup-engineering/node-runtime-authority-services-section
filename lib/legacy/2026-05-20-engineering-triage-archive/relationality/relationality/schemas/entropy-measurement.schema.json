{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EntropyMeasurement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "profile_id",
    "entropy_path",
    "base",
    "precision",
    "act_ref"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "entropy_measurement"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "entropy_path": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "base": {
      "type": "string"
    },
    "precision": {
      "type": "integer",
      "minimum": 0
    },
    "distribution_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "act_ref": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  }
}
