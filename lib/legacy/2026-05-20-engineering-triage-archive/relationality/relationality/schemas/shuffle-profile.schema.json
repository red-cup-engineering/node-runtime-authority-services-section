{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ShuffleProfile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "profile_id",
    "classes",
    "canonical_reps",
    "act_ref"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "shuffle_profile"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      }
    },
    "canonical_reps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "act_ref": {
      "type": "string"
    }
  }
}

