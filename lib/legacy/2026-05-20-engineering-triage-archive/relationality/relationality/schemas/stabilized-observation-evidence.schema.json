{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StabilizedObservationEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "observation_id",
    "equivalence_witnesses",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "stabilized_observation_evidence"
    },
    "observation_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "equivalence_witnesses": {
      "type": "object"
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "counterexample": {
      "type": "object"
    },
    "act_ref": {
      "type": "string"
    }
  }
}

