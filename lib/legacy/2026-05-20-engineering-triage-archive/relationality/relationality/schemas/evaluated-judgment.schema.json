{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvaluatedJudgment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "judgment_id",
    "evaluation_witness_id",
    "act_ref"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "evaluated_judgment"
    },
    "judgment_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evaluation_witness_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "act_ref": {
      "type": "string"
    }
  }
}

