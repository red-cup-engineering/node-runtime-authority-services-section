{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Judgment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "context_id",
    "term_id",
    "type_id",
    "triad_witness_id"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "judgment"
    },
    "context_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "term_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "type_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "triad_witness_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "normalization_witness_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}

