{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Limits",
  "type": "object",
  "required": ["id", "kind", "terminal"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "limits"
    },
    "terminal": {
      "type": "string"
    },
    "pullbacks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["apex", "left", "right"],
        "properties": {
          "apex": {"type": "string"},
          "left": {"type": "string"},
          "right": {"type": "string"},
          "projection_left": {"type": "string"},
          "projection_right": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
