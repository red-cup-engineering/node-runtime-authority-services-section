{
  "$id": "https://relationality.local/schemas/interaction-response.schema.json",
  "title": "System Interaction Response",
  "type": "object",
  "required": [
    "fixed_invariant",
    "updated_trace",
    "updated_phase_space",
    "updated_fixed_invariants",
    "operator_diagnostics"
  ],
  "properties": {
    "fixed_invariant": {"type": "object"},
    "updated_trace": {"type": "object"},
    "updated_phase_space": {"type": "object"},
    "updated_fixed_invariants": {"type": "object"},
    "operator_diagnostics": {
      "type": "object",
      "properties": {
        "intent": {"type": "string"},
        "flow_nucleus_commutation": {"type": "string"},
        "operators_used": {"type": "array", "items": {"type": "string"}},
        "spectral_effects": {"type": "object"},
        "invariants_checked": {"type": "array", "items": {"type": "string"}},
        "violations": {"type": "array", "items": {"type": "string"}},
        "commutation_evidence": {"type": "object"}
      },
      "required": ["flow_nucleus_commutation", "operators_used"]
    }
  },
  "additionalProperties": false
}
