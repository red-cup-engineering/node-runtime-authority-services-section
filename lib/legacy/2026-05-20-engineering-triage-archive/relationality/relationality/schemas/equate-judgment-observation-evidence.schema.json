{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EquateJudgmentObservationEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "observation_equivalence_id",
    "judgment_equivalence_id",
    "status",
    "act_ref"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "equate_judgment_observation_evidence"
    },
    "observation_equivalence_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "judgment_equivalence_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "type": "string",
      "enum": ["pass", "fail"]
    },
    "counterexample": {
      "type": "object"
    },
    "act_ref": {
      "type": "string"
    }
  }
}
