{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FlowMap",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "elements",
    "flow_table",
    "carrier_id"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "flow_map"
    },
    "elements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "flow_table": {
      "type": "object",
      "patternProperties": {
        ".*": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "carrier_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "act_version": {
      "type": "string"
    }
  }
}
