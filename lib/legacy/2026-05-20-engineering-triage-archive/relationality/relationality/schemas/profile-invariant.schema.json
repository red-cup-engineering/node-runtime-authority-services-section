{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProfileInvariant",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "profile_id",
    "invariant_elements",
    "flow_ref",
    "nucleus_ref",
    "regime_ref",
    "act_ref"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "profile_invariant"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "invariant_elements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "flow_ref": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nucleus_ref": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "regime_ref": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "act_ref": {
      "type": "string"
    }
  }
}

