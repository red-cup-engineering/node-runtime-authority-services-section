{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Classifier",
  "type": "object",
  "required": ["id", "kind", "truth", "false"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "classifier"
    },
    "truth": {
      "type": "string"
    },
    "false": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
