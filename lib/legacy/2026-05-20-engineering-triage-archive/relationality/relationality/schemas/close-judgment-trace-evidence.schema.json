{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CloseJudgmentTraceEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "trace_id",
    "equate_judgment_observation_evidence_id",
    "reentry_trace_evidence_id",
    "status",
    "act_ref"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "close_judgment_trace_evidence"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "equate_judgment_observation_evidence_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reentry_trace_evidence_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "counterexample": {
      "type": "object"
    },
    "act_ref": {
      "type": "string"
    }
  }
}

