{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Frontmatter Schema: Operator",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "role", "status", "inputs", "outputs", "transformation"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9-]+$"},
    "title": {"type": "string"},
    "role": {"const": "operator"},
    "status": {"type": "string", "enum": ["plan", "draft", "stable", "deprecated"]},
    "proof_refs": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "alias"],
        "properties": {
          "id": {"type": "string"},
          "alias": {"type": "string"}
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "alias"],
        "properties": {
          "id": {"type": "string"},
          "alias": {"type": "string"}
        }
      }
    },
    "transformation": {
      "type": "array",
      "items": {}
    }
  }
}
