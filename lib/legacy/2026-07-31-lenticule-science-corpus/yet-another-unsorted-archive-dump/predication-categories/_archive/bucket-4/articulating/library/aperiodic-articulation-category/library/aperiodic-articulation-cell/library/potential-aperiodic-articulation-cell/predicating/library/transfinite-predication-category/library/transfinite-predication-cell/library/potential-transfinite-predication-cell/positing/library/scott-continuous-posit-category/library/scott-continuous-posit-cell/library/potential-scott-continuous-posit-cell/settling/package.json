{
  "name": "@561/settling",
  "version": "0.0.0",
  "type": "module",
  "description": "The settling tier as a runnable, pluggable mini-package: a generic settling-endofunctor that any increment-generator plugs into, producing a settlement with closure-ordinal κ, regime classification, and Pisot inflation. Collatz, affine maps, successor, and modular arithmetic are plug-ins; tests are named for the categorical claims they verify.",
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "imports": {
    "#settling-endofunctor": "./hacking/library/settling-endofunctor/scripts/settling-endofunctor.mjs",
    "#closure-ordinal": "./hacking/library/closure-ordinal/scripts/closure-ordinal.mjs",
    "#increment-sequence": "./library/finite-settlement-algebra/hacking/library/increment-sequence/scripts/increment-sequence.mjs",
    "#settlement-spiral": "./library/finite-settlement-algebra/hacking/library/settlement-spiral/scripts/settlement-spiral.mjs",
    "#substitution": "./library/finite-settlement-algebra/hacking/library/settlement-spiral/scripts/substitution.mjs",
    "#collatz": "./library/finite-settlement-algebra/hacking/library/increment-sequence/library/collatz-increment-sequence/scripts/collatz.mjs",
    "#affine": "./library/finite-settlement-algebra/hacking/library/increment-sequence/library/affine-increment-sequence/scripts/affine.mjs",
    "#residue-commutation": "./library/finite-settlement-algebra/hacking/library/increment-sequence/library/affine-increment-sequence/scripts/residue-commutation.mjs",
    "#successor": "./library/finite-settlement-algebra/hacking/library/increment-sequence/library/successor-increment-sequence/scripts/successor.mjs",
    "#peano": "./library/finite-settlement-algebra/hacking/library/increment-sequence/library/successor-increment-sequence/library/peano-arithmetic/scripts/peano.mjs",
    "#residue": "./library/finite-settlement-algebra/hacking/library/increment-sequence/library/residue-increment-sequence/scripts/residue.mjs",
    "#shape-statistics": "./library/finite-settlement-algebra/hacking/library/settlement/library/collatz-settlement/scripts/shape-statistics.mjs",
    "#self/*": "./*"
  }
}
